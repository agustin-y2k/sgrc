# Plantilla pública de desarrollo local. No contiene claves utilizables.
# Ejecutar `make local-init`: crea .env.local con secretos aleatorios y
# docker-compose.local.yml a partir de su plantilla, sin sobrescribirlos.
# Las cuentas .test son ficticias. No usar esta configuración en producción.

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sgrc_db
POSTGRES_USER=sgrc
POSTGRES_PASSWORD=cambiar
JWT_SECRET=cambiar
OUTBOX_SECRET=cambiar
CUENTAS_SECRET=cambiar
JWT_ACCESS_TTL=24h
JWT_REMEMBER_TTL=720h

SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_PASSWORD=cambiar
ADMIN_AUX_EMAIL=admin.secundario@local.test
ADMIN_AUX_PASSWORD=cambiar
DOCENTE_EMAIL=docente@local.test
DOCENTE_PASSWORD=cambiar

FRONTEND_ORIGIN=http://localhost:8081
TRUSTED_PROXIES=172.30.70.0/24
APP_PORT=8080
APP_TIMEZONE=America/Argentina/Buenos_Aires
RETIRO_GRACIA_MINUTOS=40
CIERRE_JORNADA=23
LICENCIAS_HORA_AVISO=7

# La copia local funciona sin proveedores externos ni túnel.
GOOGLE_CLIENT_ID=
GOOGLE_DOMINIOS_PERMITIDOS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TUNNEL_TOKEN=
GRAFANA_PASSWORD=cambiar
PING_URL_RESERVAS_VENCIDAS=
PING_URL_BARRIDO_ENTREGAS=
PING_URL_AVISO_LICENCIAS=
