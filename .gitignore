# ─────────────────────────────────────────────────────────────────────
# Secretos y datos de la institución
# ─────────────────────────────────────────────────────────────────────

# Configuración con secretos reales: la contraseña de Postgres, el secreto
# que firma las sesiones y el token del túnel. El que se versiona es
# .env.example, con valores de ejemplo.
.env
.env.*
!.env.example
!.env.local.example

# Configuración de cada instalación. Los ejemplos *.local.example.yml sí
# se publican; las copias activas y los overlays automáticos son privados.
*compose*.local.yml
*compose*.local.yaml
*compose*.override.yml
*compose*.override.yaml

# Volcados de la base: tienen los datos de la institución y los hashes de
# contraseña de todas las cuentas. No salen del servidor.
backup-sgrc-*.sql
*.sql.gz
*.sql.bz2
*.sql.xz
*.sql.zst
*.dump
backup*.sql
dump*.sql
*-backup*.sql
*_backup*.sql
backups/
datos-locales/
sgrc-datos/
# También proteger estos archivos si se copian fuera de la carpeta privada.
accesos-locales*.txt
usuarios-locales*.json
inventario-para-local*.sql*
backup*.zip
backup*.7z
backup*.tar
backup*.tar.*
dump*.zip
dump*.7z
dump*.tar
dump*.tar.*

# Copias locales que pueden conservar configuración o credenciales.
*.bak
*.backup
*.old
*.orig
*.rej
*.tmp
*.local
.envrc
.npmrc
.pypirc
.netrc
.git-credentials
credentials*.json
client_secret*.json
service-account*.json
service_account*.json
token.json
tokens.json

# Bases locales; los scripts SQL de migrations/ sí se versionan.
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# Certificados y llaves, por si alguna vez se generan dentro del repo.
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# ─────────────────────────────────────────────────────────────────────
# Artefactos de compilación
# ─────────────────────────────────────────────────────────────────────

/bin/
sgrc-app

# Cobertura de Go
coverage.out
coverage.html

# ─────────────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────────────

frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.vite/

# Herramientas locales de preparación de datos.
__pycache__/
*.pyc

# ─────────────────────────────────────────────────────────────────────
# Herramientas locales de cada quien
# ─────────────────────────────────────────────────────────────────────
#
# Las carpetas ocultas son configuración personal: preferencias del editor y
# de las utilidades de línea de comandos de cada máquina, con rutas absolutas
# que no le sirven a nadie más y que ensucian los diffs de todo el equipo. Se
# excluyen todas por regla —.vscode/, .idea/ y cualquier otra— en vez de ir
# agregando una línea cada vez que alguien estrena una herramienta nueva.
#
# La excepción es .github/, que sí es del proyecto (plantillas de issues,
# workflows de integración continua).
.*/
!.github/

# Instrucciones y conexiones personales de herramientas de desarrollo.
AGENTS.md
AGENTS.local.md
AGENTS.override.md
CLAUDE.md
CLAUDE.local.md
CODEX.md
GEMINI.md
copilot-instructions.md
.mcp*.json
mcp.json
mcp-config*.json
mcp_servers.json

# Lo que los editores dejan FUERA de una carpeta oculta, que la regla de
# arriba no alcanza. Los IDE de JetBrains (GoLand, IntelliJ) son el caso:
# guardan la configuración en .idea/ pero además escriben un .iml por módulo
# en la raíz del proyecto y compilan a out/.
*.iml
/out/

# Editores de terminal
*.swp
*.swo
*~

# Logs sueltos de cualquier herramienta
*.log

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Planillas con las que se importa la estructura de un ciclo. Son datos de una
# institución concreta —su lista real de materias por división— y este repo es
# un producto público: la planilla se carga desde la pantalla y no vive acá.
/materias_por_division.csv
/*-materias*.csv

# Documentos de diseño intermedios: material de trabajo mientras se decide algo.
# Lo que la funcionalidad termina siendo vive en docs/01-requisitos.md.
/docs/superpowers/

# Informes de trabajo y diagnósticos de una instalación. La documentación
# compartida describe el producto y sus procedimientos reproducibles.
[Aa][Nn][Aa][Ll][Ii][Ss][Ii][Ss]_*.md
[Aa][Nn]Á[Ll][Ii][Ss][Ii][Ss]_*.md
[Aa][Nn]á[Ll][Ii][Ss][Ii][Ss]_*.md
/docs/revisiones/
/docs/*-revision*.md
/docs/*-estructura-frontend-y-guia.md
