# Configuración de la pila que genera las capturas de las guías.
#
#   cp .env.capturas.example .env.capturas
#   make capturas
#
# No es un despliegue: la pila se crea y se destruye dentro de la misma
# corrida, en el proyecto de Compose `sgrc-capturas`, y nunca sale de la
# máquina. Por eso las claves de acá son valores fijos de juguete y no hay que
# inventar ninguna — al revés de .env.example, donde cada una hay que
# cambiarla.
#
# Lo único que SÍ hay que mirar son los dos correos: se ven en las capturas de
# Usuarios y Mi perfil, y estas guías van a un repositorio público.

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sgrc_db
POSTGRES_USER=sgrc_app
POSTGRES_PASSWORD=capturas_postgres_local

# 32 bytes es el mínimo que exige el arranque, para los dos.
JWT_SECRET=capturas-jwt-secret-de-juguete-32b
JWT_ACCESS_TTL=24h
CUENTAS_SECRET=capturas-cuentas-secret-juguete32

# ── Los dos correos que se VEN en las capturas ───────────────────────────
#
# SEED_ADMIN_EMAIL es la cuenta que aparece en Usuarios, en Mi perfil y en el
# pie de los avisos. DOCENTE_EMAIL es el docente que siembra el overlay de
# desarrollo. Si acá va una casilla personal, las capturas la publican — y
# buscar texto en el PDF NO lo detecta, porque las pantallas son imágenes.
# capturar-todo.sh se niega a arrancar si detecta un dominio personal.
#
# Tienen que ser DISTINTOS entre sí: Ada Lovelace pide una materia y Ana Gómez
# —que crea datos-de-demostracion.sh— reserva. Con el mismo correo, la segunda
# reusa la cuenta de la primera y el paso del pedido de materia se cae.
SEED_ADMIN_EMAIL=admin@escuela.edu.ar
SEED_ADMIN_PASSWORD=capturas.local.2026
DOCENTE_EMAIL=ada.lovelace@escuela.edu.ar
DOCENTE_PASSWORD=capturas.docente.2026

VITE_API_URL=
FRONTEND_ORIGIN=http://localhost:8081

# Tiene que coincidir con la subred de docker-compose.capturas.yml. `sgrc-net`
# tiene subred fija en docker-compose.yml para poder nombrarla acá, y una
# subred fija no entra dos veces: con la red de desarrollo ya creada, la de
# capturas muere con "Pool overlaps with other one on this address space". Por
# eso la de capturas usa la de al lado. Los dos valores van juntos: si no
# coinciden, el backend deja de confiar en el proxy y no lo avisa.
TRUSTED_PROXIES=172.29.0.0/16

APP_PORT=8080
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Opcional. Con un client id acá, la captura del ingreso muestra el botón
# «Acceder con Google» que la guía explica; sin él, no. No es un secreto —el
# navegador ya lo recibe en /api/auth/config— pero es de cada instalación.
GOOGLE_CLIENT_ID=
GOOGLE_DOMINIOS_PERMITIDOS=

# SMTP APAGADO a propósito: el pipeline aprueba cuentas y cancela reservas, y
# con un servidor configurado esos correos se mandan de verdad. Apagado también
# cambia una captura —sin SMTP no aparece «Olvidé mi contraseña» en el ingreso—
# y esa es la variante que queremos: no depende de la casilla de nadie.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Escuela

LICENCIAS_HORA_AVISO=20
RETIRO_GRACIA_MINUTOS=40
CIERRE_JORNADA=18
RETIRO_PARCIAL_GRACIA_MINUTOS=15

PING_URL_RESERVAS_VENCIDAS=
PING_URL_BARRIDO_ENTREGAS=
PING_URL_AVISO_LICENCIAS=
