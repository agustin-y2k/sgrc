# Configuración de una instalación de SGRC.
# Copiar a .env con permisos 0600 y completar los valores de la institución.
# Esta plantilla es pública; no escribir aquí credenciales reales.
# Para una copia local independiente usar: make local-init && make local.

# PostgreSQL: servicio interno de Docker Compose.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sgrc_db
POSTGRES_USER=sgrc_app
POSTGRES_PASSWORD=cambiar_en_produccion

# Firma de sesiones. Generar una clave propia con: openssl rand -base64 48
# Se requieren al menos 32 bytes. El marcador impide un arranque sin configurar.
JWT_SECRET=CAMBIAME
JWT_ACCESS_TTL=24h
JWT_REMEMBER_TTL=720h

# Cifrado de eventos pendientes, al menos 32 bytes; conservar en los respaldos.
# Vacío: deriva una clave de JWT_SECRET. Cambiar JWT_SECRET en ese caso impide
# descifrar los eventos pendientes. Ver docs/11-operacion.md.
OUTBOX_SECRET=

# Cifrado de contraseñas de cuentas de equipos, independiente del JWT.
# Vacío permite cargar cuentas sin guardar contraseñas. Al configurarlo se
# requieren al menos 32 bytes. Cambiarlo impide leer contraseñas anteriores.
CUENTAS_SECRET=

# Administrador inicial: sólo se crea si no hay ningún administrador aprobado.
# Cambiar el archivo no actualiza la contraseña de una cuenta ya existente.
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=cambiar_inmediatamente

# Cuenta ficticia del servicio seed-datos del entorno de desarrollo.
# No se ejecuta en producción ni se utiliza para generar las guías.
DOCENTE_EMAIL=docente@escuela.test
DOCENTE_PASSWORD=docente_password_123

# Origen público propio, con esquema y sin barra final. No dejar vacío.
# VITE_API_URL pertenece al build del frontend y se configura por separado.
FRONTEND_ORIGIN=https://sgrc.example.org

# Acceso con Google, opcional. El backend verifica ID tokens del cliente web.
# La lista de dominios admitidos usa comas; vacía no restringe por dominio.
GOOGLE_CLIENT_ID=
GOOGLE_DOMINIOS_PERMITIDOS=

# Correo opcional. SMTP_HOST vacío deshabilita los envíos externos.
# Usar el puerto STARTTLS del proveedor (587 por defecto); 465 no se admite.
# SMTP_FROM vacío utiliza SMTP_USER. Completar las credenciales del proveedor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Institución

# Despliegue con Cloudflare Tunnel: ingress hacia http://frontend:80.
TUNNEL_TOKEN=cambiar_por_el_token_del_tunel
# Subred interna del Compose base. Ajustar si se personaliza la red.
TRUSTED_PROXIES=172.28.0.0/16
APP_PORT=8080
# Zona IANA de la institución; el valor siguiente es un ejemplo configurable.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Barrido de licencias: primera ejecución a partir de esta hora local.
LICENCIAS_HORA_AVISO=7
# Intervalo del barrido en minutos (1 a 1440), opcional.
#LICENCIAS_INTERVALO_MINUTOS=60

# Plazo desde el inicio de la clase para liberar equipos no retirados.
# La liberación requiere que el mostrador esté atendido.
RETIRO_GRACIA_MINUTOS=40
# Hora alternativa de corte cuando la institución no declaró su jornada.
# Con jornada declarada se utiliza una hora después del cierre de cada día.
# El resumen se emite una sola vez por préstamo pendiente, sin cerrar la custodia.
CIERRE_JORNADA=23

# Monitoreo opcional: una URL privada de heartbeat por tarea.
# Frecuencia esperada: reservas y entregas cada 5 min; licencias cada hora.
PING_URL_RESERVAS_VENCIDAS=
PING_URL_BARRIDO_ENTREGAS=
PING_URL_AVISO_LICENCIAS=

# Perfil de observabilidad. Generar con: openssl rand -base64 24
# La contraseña se aplica al inicializar el volumen de Grafana.
GRAFANA_PASSWORD=cambiar_por_una_contrasena_larga
