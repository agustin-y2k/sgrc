# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sgrc_db
POSTGRES_USER=sgrc_app
POSTGRES_PASSWORD=cambiar_en_produccion

# JWT (HS256)
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
# Vigencia de la sesión normal. Una jornada escolar: quien entra a la mañana
# no vuelve a tipear la contraseña antes de irse.
JWT_ACCESS_TTL=24h
# Vigencia cuando la persona tilda "Mantener la sesión iniciada" al ingresar.
# 720h = 30 días. Bajarlo endurece el sistema; subirlo alarga la ventana en la
# que un dispositivo perdido sigue entrando (la única forma de cortar esa
# sesión a distancia es cambiar la contraseña de la cuenta).
JWT_REMEMBER_TTL=720h

# Cifra las contraseñas de las cuentas de cada equipo (RF-03.22): las de
# Windows, Linux o Microsoft con las que se abre cada notebook. No es lo mismo
# que JWT_SECRET y no se comparte con él.
#
# OPCIONAL. Sin esto el sistema arranca igual y las cuentas se pueden cargar;
# lo único que no se puede es guardar sus contraseñas.
#
# Es lo que hace que el volcado de `make backup` no sea una lista de las
# contraseñas de todas las máquinas de la institución. Generalo con
# `openssl rand -base64 48`.
#
# OJO: si se cambia, las contraseñas ya guardadas dejan de poder leerse y hay
# que volver a cargarlas mirando las máquinas. No se pierde nada más.
CUENTAS_SECRET=

# Admin seed. Solo se usan si todavía no existe ningún usuario con
# rol=ADMIN: cmd/main.go lo siembra al arrancar, de forma idempotente, y en
# los arranques siguientes no hace nada. Cambiar la contraseña apenas se
# ingresa por primera vez.
SEED_ADMIN_EMAIL=admin@tuinstitucion.edu.ar
SEED_ADMIN_PASSWORD=cambiar_inmediatamente

# El docente de prueba, SOLO PARA DESARROLLO. Lo crea el servicio `seed-datos`
# del overlay `docker-compose.dev.yml` —que no existe en el servidor— junto con
# un ciclo, un curso, una materia y un carro con equipos, para tener con qué
# probar apenas se levanta el sistema.
#
# Si no están, el script usa docente@escuela.edu.ar / docente_password_123.
# Al generar las capturas de las guías hay que ponerle un correo DISTINTO del
# docente que crea `docs/guias/generar/datos-de-demostracion.sh`, que son dos
# personas: ver el README de esa carpeta.
DOCENTE_EMAIL=docente@escuela.edu.ar
DOCENTE_PASSWORD=docente_password_123

# Frontend. El deploy es same-origin: nginx sirve la SPA y proxea /api hacia
# sgrc-app (ver frontend/nginx.conf), así que el navegador nunca cruza de
# dominio. FRONTEND_ORIGIN es el dominio público del túnel, y lo usa el CORS
# del backend (RNF-04). Va con esquema y sin barra final. Vacío NO es una
# opción: el backend no arranca sin él, porque dejarlo vacío abriría el CORS
# a cualquier origen.
#
# `VITE_API_URL` NO va acá aunque se le parezca: es una variable de
# COMPILACIÓN del frontend y Vite la lee de `frontend/.env`, no de este
# archivo (ver frontend/.env.example). Ponerla acá no hace nada — no llega al
# build, porque el servicio `frontend` del compose se construye sin
# argumentos—. Vacía es la configuración normal y solo hace falta si algún
# día la SPA se sirve desde otro host que la API.
FRONTEND_ORIGIN=https://sgrc.tuinstitucion.edu.ar

# Ingreso con cuenta de Google (OPCIONAL).
#
# Vacío o ausente = el sistema funciona exactamente como antes: solo email y
# contraseña, y la pantalla de login ni siquiera dibuja el botón de Google.
#
# Para habilitarlo, en https://console.cloud.google.com/apis/credentials:
#   1. Creá un proyecto (gratis, no pide tarjeta) y configurá la pantalla de
#      consentimiento. Con los scopes por defecto (openid, email, profile —
#      no sensibles) NO hace falta pasar por el proceso de verificación de
#      Google, pero SÍ hay que publicar la app: en estado "Testing" hay un
#      tope de 100 usuarios.
#   2. Creá una credencial "ID de cliente de OAuth 2.0" de tipo
#      "Aplicación web".
#   3. En "Orígenes autorizados de JavaScript" poné el dominio público
#      exacto, con https y sin barra final — el mismo valor que
#      FRONTEND_ORIGIN. Sin esto Google rechaza el botón sin explicar por
#      qué. NO hace falta configurar "URI de redireccionamiento": este
#      sistema usa el flujo de ID token, que no redirige a ningún lado.
#   4. Copiá el "ID de cliente" acá abajo. Es público (viaja al navegador en
#      cada pedido), no es un secreto — y de hecho no hay ningún client
#      secret involucrado en este flujo.
GOOGLE_CLIENT_ID=
#
# Restringe QUÉ cuentas de Google pueden pedir registrarse, por dominio del
# email (lista separada por comas, sin @). Vacío = cualquier cuenta de
# Google puede solicitar el alta.
#
# Ojo con qué protege y qué no: aun sin esta lista nadie entra al sistema
# sin que un Admin apruebe su cuenta (RF-01.3), así que dejarla vacía no
# abre el acceso. Lo que evita es que el Admin tenga que revisar y rechazar
# solicitudes de cualquier persona de internet. Si la escuela tiene su
# propio dominio de correo, ponelo; si los docentes usan Gmail personal,
# dejala vacía.
GOOGLE_DOMINIOS_PERMITIDOS=

# Envío de correo (OPCIONAL).
#
# Vacío o ausente = el sistema arranca y funciona como venía funcionando:
# los avisos siguen llegando a la campana de notificaciones y no sale ningún
# mail. Lo único que NO funciona sin esto es la recuperación de contraseña
# por autoservicio ("olvidé mi contraseña"): el enlace ni siquiera aparece
# en la pantalla de login, y la salida sigue siendo que un Admin resetee la
# contraseña desde la pantalla de usuarios (RF-01.6).
#
# Con esto configurado, el sistema manda correo en tres familias (RF-05.13):
#   1. los FIJOS, que no se pueden apagar: la cuenta aprobada, el código para
#      recuperar la contraseña y los dos de soporte;
#   2. el de cuentas pendientes a los Admin, encendido de fábrica: alguien se
#      registró y no puede entrar hasta que lo miren;
#   3. los OPTATIVOS, apagados de fábrica y que cada persona enciende en su
#      perfil: reserva cancelada, licencia por vencer, pedidos, sugerencias,
#      recordatorio de reserva y equipos sin devolver al cierre.
#
# Nada de esto reemplaza la campana de notificaciones, que es la fuente de
# verdad y no se puede apagar.
#
# ── Cómo obtener estos datos con el Gmail de la escuela ───────────────
#
# Se usa una cuenta de Gmail común (no hace falta Workspace ni dominio
# propio) con una CONTRASEÑA DE APLICACIÓN, que no es la contraseña con la
# que se entra a Gmail:
#
#   1. En la cuenta de la escuela, activá la verificación en dos pasos
#      (https://myaccount.google.com/signinoptions/twosv). Sin eso el paso
#      siguiente no existe.
#   2. Entrá a https://myaccount.google.com/apppasswords, creá una y copiala.
#      Google la muestra como "abcd efgh ijkl mnop"; se puede pegar con los
#      espacios, el sistema se los saca.
#   3. Poné esa cuenta en SMTP_USER y SMTP_FROM, y la contraseña de
#      aplicación en SMTP_PASSWORD.
#
# El límite de Gmail es de ~500 destinatarios por día, de sobra para avisos.
# Es gratis: lo que cambió en 2022 es que exige contraseña de aplicación, no
# que el SMTP haya dejado de serlo.
#
# SMTP_HOST vacío = correo deshabilitado. Con SMTP_HOST puesto, el proceso
# NO arranca si falta SMTP_FROM/SMTP_USER o SMTP_PASSWORD: una configuración
# a medias fallaría en cada envío, dentro de una goroutine cuyo error solo
# se loguea, y ese es el modo de falla que nadie mira.
SMTP_HOST=
# 587 por defecto. Tiene que ser el puerto de STARTTLS: el 465 (TLS
# implícito desde el saludo) no está soportado.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Dirección desde la que salen los correos. Con Gmail tiene que ser la misma
# cuenta que autentica (o un alias verificado); si se deja vacía se usa
# SMTP_USER.
SMTP_FROM=
# Nombre visible del remitente, opcional. Es lo que el docente ve en la
# lista de correos en vez de la dirección pelada.
SMTP_FROM_NAME=Escuela

# Cloudflare Tunnel. Token del túnel creado en el panel de Cloudflare; el
# ingress de ese túnel tiene que apuntar a http://frontend:80.
TUNNEL_TOKEN=cambiar_por_el_token_del_tunel

# Redes desde las que se acepta el header CF-Connecting-IP con la IP real del
# cliente (lista separada por comas). Es la subred de sgrc-net, fijada en
# docker-compose.yml. Sin esto, el rate limiting por IP y audit_log.ip_origen
# ven la IP de nginx en vez de la del docente.
TRUSTED_PROXIES=172.28.0.0/16

# App
APP_PORT=8080

# Zona horaria de la escuela. Las columnas de horario (reserva.hora_inicio,
# horario_admin.hora_inicio) son TIME sin zona: representan la hora de pared
# de la institución, así que el proceso tiene que leer "ahora" en esta misma
# zona. Sin esto el contenedor corre en UTC y el job de vencimiento
# finalizaría las reservas 3 horas antes de que terminen.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Hora (0-23, en la zona de arriba) a partir de la cual sale el aviso diario
# de licencias de software por vencer (RF-03.14). Por defecto 7: el mail
# está en la casilla antes de que alguien llegue a la escuela, y no en mitad
# de la noche.
#
# Es un "no antes de", no un horario exacto. El barrido corre cada hora y la
# primera pasada después de esta hora manda el aviso; las siguientes no
# encuentran nada porque cada licencia queda marcada. Por eso reiniciar el
# contenedor no duplica ningún mail.
LICENCIAS_HORA_AVISO=7

# Cada cuántos minutos se revisa si hay licencias por vencer (1 a 1440).
#
# El default es 60 y en producción no hay motivo para tocarlo: lo que decide
# CUÁNDO sale el aviso es LICENCIAS_HORA_AVISO, no esto. Existe para poder ver
# el ciclo completo sin esperar una hora —al probar el sistema o al preparar
# una capacitación—: con 1, el aviso aparece en la campana al minuto de cargar
# una licencia vencida.
#LICENCIAS_INTERVALO_MINUTOS=60

# ── Barrido de reservas y entregas (RF-08) ────────────────────────────
#
# Todos son opcionales. Sin ellos quedan los valores por defecto, que son
# los que la escuela venía usando en la práctica antes de que el sistema los
# llevara.
#
# Los dos que quedan LIBERAN y no avisan nada, y no son lo mismo: uno cuenta
# desde el inicio de la clase (40 minutos por defecto) y el otro desde la
# última entrega (15). Ninguno manda correo — el que lo mandaba se retiró en
# la 1.18.0, ver abajo.

# RETIRO_AVISO_MINUTOS y DEVOLUCION_DEMORA_MINUTOS ya no existen (1.18.0).
#
# El aviso de "todavía no las retiraste" y el reclamo de devolución demorada
# se retiraron. Los dos deducían algo de lo que NO estaba registrado —que
# nadie fue a buscar las máquinas, que nadie las devolvió— y eso solo es
# cierto si hay un administrador operando el sistema. El día que falta y lo
# cubre alguien que anota en papel, los dos avisos acusan a docentes que
# hicieron todo bien.
#
# Ahora el barrido directamente no concluye nada sin alguien atendiendo el
# mostrador (RF-07.6), y esos dos avisos perdieron su razón de ser. Si estas
# variables siguen en el archivo, el sistema levanta igual y lo avisa en el
# log.

# Minutos que se esperan desde la última entrega antes de liberar lo que el
# docente NO se llevó, cuando vino a buscar una parte de su reserva.
#
# Es más corto que el plazo de abajo porque responde a otra pregunta: ahí el
# sistema no sabe si el docente va a venir, acá ya vino y eligió qué se
# llevaba. Y no avisa nada, porque eso lo decidió él en el mostrador.
RETIRO_PARCIAL_GRACIA_MINUTOS=15

# Minutos que se esperan desde el inicio de la clase antes de liberar una
# computadora que nadie vino a retirar. Pasado ese plazo, esa máquina deja de
# estar reservada y otro docente puede usarla.
#
# Liberar no es prohibir: si el docente llega más tarde y las máquinas siguen
# en el laboratorio, se le entregan igual. Lo único que pasó es que dejaron
# de estar guardadas a su nombre.
#
# Una reserva más corta que este plazo no se libera nunca, y está bien:
# liberar los últimos minutos de una clase no le sirve a nadie.
RETIRO_GRACIA_MINUTOS=40


# Hora (0-23, en la zona de APP_TIMEZONE) a partir de la cual se avisa qué
# computadoras quedaron fuera del laboratorio.
#
# SOLO se usa si la institución NO declaró su jornada. Cuando la declaró, el
# corte sale de ahí: una hora después de que la escuela cierra ESE día. Así
# una que cierra a las 22 recibe el aviso a las 23 y no a media tarde con las
# máquinas todavía en clase, y una nocturna que cierra a la 01:00 lo recibe a
# las 02:00, ya entrado el día siguiente.
#
# El aviso sale UNA sola vez por préstamo. Lo que sostiene la insistencia no
# es el correo sino la pantalla de entregas: la máquina figura afuera hasta
# que alguien la recibe. Si nunca vuelve, se le da de baja del inventario.
#
# Los días que la escuela no abre no tienen corte, así que una jornada de
# lunes a viernes no avisa nada el sábado ni el domingo.
CIERRE_JORNADA=23

# ───────────────────────────────────────────────────────────────────────
# Aviso de vida de los barridos (opcional)
# ───────────────────────────────────────────────────────────────────────
#
# Los tres barridos de fondo corren en goroutines del mismo proceso. Si una
# muere o se cuelga, el sistema sigue respondiendo, el healthcheck da verde y
# nadie se entera: lo que deja de pasar —reservas que no se finalizan,
# máquinas que no se liberan, licencias por vencer que nadie avisa— se
# descubre semanas después.
#
# La detección no puede depender de que el sistema avise cuando algo falla:
# una goroutine muerta tampoco puede avisar. Es al revés. Cada barrido le
# pega a su URL cada vez que termina bien, y el servicio externo alerta
# cuando ese aviso DEJA de llegar. El silencio es la señal.
#
# Sirve cualquier servicio de "heartbeat" o "cron monitoring" que entregue
# una URL por chequeo (hay opciones gratuitas). Cada variable vacía deja ese
# barrido sin vigilancia; el sistema arranca igual.
#
# El período que hay que configurar en el servicio, para cada uno:
#
#   RESERVAS_VENCIDAS  cada 5 minutos
#   BARRIDO_ENTREGAS   cada 5 minutos
#   AVISO_LICENCIAS    cada hora — avisa en cada vuelta, también en las horas
#                      en que no manda ningún correo (ver LICENCIAS_HORA_AVISO):
#                      lo que se vigila es que la goroutine siga viva, no que
#                      haya trabajo que hacer.
#
# Poner una holgura: si el servicio espera exactamente 5 minutos, un barrido
# que tarde unos segundos de más va a alertar sin que pase nada malo.
#
# Esto NO reemplaza a un monitor externo del sitio: si el túnel se cae, el
# sistema queda inalcanzable desde afuera con todo sano adentro, y los avisos
# de los barridos van a seguir llegando puntualmente.
PING_URL_RESERVAS_VENCIDAS=
PING_URL_BARRIDO_ENTREGAS=
PING_URL_AVISO_LICENCIAS=

# ───────────────────────────────────────────────────────────────────────
# Tableros de Prometheus y Grafana (opcional)
# ───────────────────────────────────────────────────────────────────────
#
# Solo se usa si se levanta el perfil de observabilidad:
#
#   docker compose --profile observabilidad up -d
#
# Es la contraseña del usuario `admin` de Grafana. Cambiala antes de
# levantarlo: los tableros muestran cómo se comporta el sistema por dentro y
# el panel queda escuchando en el servidor. Ver docs/12-observabilidad.md.
GRAFANA_PASSWORD=cambiar_por_una_contrasena_larga
